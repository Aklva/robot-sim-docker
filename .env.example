# Copy to .env and edit as needed.

# Match these to your NixOS host user to avoid root-owned build outputs in bind mounts.
# Check with: id -u && id -g
USER_UID=1000
USER_GID=1000
CONTAINER_USER=ros

# ROS 2 domain shared by ros-gazebo and Isaac Lab ROS2 containers.
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# LimX robot type used by Gazebo launch scripts.
ROBOT_TYPE=PF_P441C

# Xauthority file generated by scripts/prepare-x11.sh.
XAUTH=/tmp/.docker.xauth

# scripts/compose.sh adds compose.nvidia-cdi.yml by default.
# Set USE_NVIDIA_CDI=0 when debugging on a non-NVIDIA machine.
USE_NVIDIA_CDI=1

# Isaac Lab official Docker setup.
ISAACLAB_REPO=https://github.com/isaac-sim/IsaacLab.git
# Compatibility versions and immutable refs are owned by versions.env.
# Do not override ISAACLAB_REF or LEISAAC_REF here.
ISAACLAB_DIR=IsaacLab
ISAACLAB_X11=1

# LeIsaac host checkout. You may also replace this directory with your leisaac.zip contents.
LEISAAC_REPO=https://github.com/LightwheelAI/leisaac.git
LEISAAC_DIR=leisaac

# MuJoCo standalone tarball version used by the Ubuntu container.
MUJOCO_VERSION=3.4.0
