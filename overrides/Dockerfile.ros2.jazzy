# Local ROS 2 image override for Isaac Lab 2.3 / Isaac Sim 5.1.
# Isaac Sim 5.1 is based on Ubuntu 24.04, so use ROS 2 Jazzy (noble)
# instead of the upstream Humble (jammy) Dockerfile.

ARG DOCKER_NAME_SUFFIX=""

FROM isaac-lab-base${DOCKER_NAME_SUFFIX} AS ros2

ARG ROS2_APT_PACKAGE

RUN --mount=type=cache,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    curl \
    software-properties-common && \
    add-apt-repository universe && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    # packages.ros.org currently redirects HTTPS to a mirror whose certificate \
    # does not match the requested hostname. Package signatures are still \
    # verified by apt through signed-by, so use HTTP for this signed repository. \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu noble main" \
      > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-${ROS2_APT_PACKAGE} \
    ros-jazzy-vision-msgs \
    ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-rmw-fastrtps-cpp \
    ros-dev-tools && \
    ${ISAACLAB_PATH}/isaaclab.sh -p \
      ${ISAACLAB_PATH}/tools/install_deps.py rosdep ${ISAACLAB_PATH}/source && \
    apt-get -y autoremove && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    echo "source /opt/ros/jazzy/setup.bash" >> ${HOME}/.bashrc

COPY docker/.ros/ ${DOCKER_USER_HOME}/.ros/
